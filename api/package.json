{
  "name": "@courtly/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "start": "tsx --env-file-if-exists=.env src/app.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "node-pg-migrate up",
    "db:codegen": "kysely-codegen --dialect postgres --camel-case --out-file src/db/db.generated.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
